    if not Bmc then
        return Amc
    end
    local Cmc = {
    }
    for Dmc, Emc in ipairs(Units.equipped()) do
        Cmc [Emc.uuid] = true
    end
    local Fmc = {
    }
    for Gmc, Hmc in pairs(Bmc.profile_data.collection.owned_units) do
        local Imc = Core.Units [Hmc.unit_id]
        if Imc and (Cmc [Gmc] or Hmc._locked or Imc.rarity == "Secret" or Imc.rarity == "Mythic" or Gmc == ymc) then
            local Jmc, Kmc = pcall(Core.USC.calculate_level, Hmc.unit_id, Hmc.xp)
            Kmc = Jmc and tonumber(Kmc) or 0
            table.insert(Fmc, {
                uuid = Gmc,
                u = Hmc,
                lvl = Kmc,
                team = Cmc [Gmc],
                key = (Cmc [Gmc] and 4000 or 0) + (Hmc._locked and 2000 or 0) + (Imc.rarity == "Secret" and 1000 or 0) + Kmc
            })
        end
    end
    table.sort(Fmc, function(Lmc, Mmc)
        if Lmc.key ~= Mmc.key then
            return Lmc.key > Mmc.key
        end
        return Lmc.uuid < Mmc.uuid
    end)
    for Nmc, Omc in ipairs(Fmc) do
        local Pmc, Qmc = true, ""
        if zmc then
            Pmc, Qmc = pcall(zmc, Omc.u)
