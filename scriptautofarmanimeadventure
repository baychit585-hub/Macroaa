        hmc(Config.snipeUnit, "", 9)
    end
    for mmc, nmc in pairs(cmc.feat or {
    }) do
        for omc, pmc in ipairs(nmc) do
            hmc(pmc, " · featured on " .. (FarmHub.BANNER_NAME [mmc] or mmc), 3)
        end
    end
    for qmc, rmc in pairs(cmc.seen or {
    }) do
        if type(rmc) == "table" then
