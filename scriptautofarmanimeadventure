function GUI.simView(Quc)
    if App.where == "match" and Match.ld then
        local Ruc = Match.pred
        local Suc
        if not Ruc then
            Suc = (Match.planning or (Match.laneWant and not Match.laneCut)) and "Simulator: choosing spots…" or "Simulator: no prediction for this run"
        elseif Match.infinite then
            Suc = string.format("Simulator: the base falls at wave %d (%.0f min)", Ruc.wave or 0, (Ruc.t or 0) / 60)
        else
            Suc = string.format("Simulator: %s at wave %d (%.0f min)", Ruc.won and "a win" or "a loss", Ruc.wave or 0, (Ruc.t or 0) / 60)
        end
        local Tuc = {
        }
        if Match.style then
            table.insert(Tuc, "Placement: " .. (GUI.STYLE_NAMES [Match.style] or Match.style) .. (Match.styleWhy and (" (" .. tostring(Match.styleWhy) .. ")") or ""))
        end
        if Match.laneWant then
            table.insert(Tuc, Match.laneCut and string.format("lane %s, the one this portal opened (%d of %d)", Match.laneCut, Match.laneWant, Match.laneTotal or 0) or string.format("waiting for the first enemies to show which lane this portal opened (%d of %d)", Match.laneWant, Match.laneTotal or 0))
        end
        if Match.trainee and Brain.train.on then
            table.insert(Tuc, "training " .. Units.name(Brain.train.on.id))
        end
        local Uuc, Vuc, Wuc = "", nil, "no wave measured yet"
        local Xuc = Match.calRun and Match.calRun.alive or {
        }
        for Yuc = Match.wave(), 1, - 1 do
            local Zuc, _uc = tonumber(Xuc [tostring(Yuc)]), Ruc and Ruc.aliveAt and tonumber(Ruc.aliveAt [Yuc])
            if Zuc and _uc then
                local avc = 1000
                if Zuc < avc and _uc < avc then
                    Uuc, Vuc, Wuc = "ON TRACK", Quc.green, string.format("wave %d started with every enemy before it cleared, as the simulator expected", Yuc)
                elseif _uc < avc then
                    Uuc, Vuc, Wuc = "BEHIND", Quc.red, string.format("wave %d started with %s HP still alive where the simulator expected none", Yuc, Utils.fmt(Zuc))
                elseif Zuc < avc then
                    Uuc, Vuc, Wuc = "AHEAD", Quc.green, string.format("wave %d started with nothing left where the simulator expected %s HP", Yuc, Utils.fmt(_uc))
                else
                    local bvc = Zuc / _uc
                    Uuc = bvc <= 0.8 and "AHEAD" or (bvc <= 1.25 and "ON TRACK" or (bvc <= 2 and "BEHIND" or "FAR BEHIND"))
                    Vuc = bvc <= 1.25 and Quc.green or (bvc <= 2 and Quc.orange or Quc.red)
                    Wuc = string.format("wave %d started with %s HP alive, the simulator expected %s (%s)", Yuc, Utils.fmt(Zuc), Utils.fmt(_uc), bvc <= 0.8 and string.format("%.1f× easier", 1 / bvc) or (bvc <= 1.25 and "close" or string.format("%.1f× harder", bvc)))
                end
                break
            end
        end
        if FarmHub.every("simCardShares", 5) then
            local cvc, dvc = pcall(Match.damageShares)
            local evc = {
            }
            for fvc, gvc in pairs(cvc and type(dvc) == "table" and dvc or {
            }) do
                if gvc >= 0.01 then
                    table.insert(evc, {
                        n = Units.name(fvc):gsub(" %(.+%)",
                        ""),
                        v = gvc
                    })
                end
            end
            table.sort(evc, function(hvc, ivc)
                return hvc.v > ivc.v
            end)
            local jvc = {
            }
            for kvc = 1, math.min(4, # evc) do
                table.insert(jvc, string.format("%s %d%%", evc [kvc].n, math.floor(evc [kvc].v * 100 + 0.5)))
            end
            GUI.simShares = # jvc > 0 and ("damage: " .. table.concat(jvc, ", ")) or nil
        end
        return {
            icon = "🔮",
            title = Suc,
            text = # Tuc > 0 and table.concat(Tuc,
            " · ") or "",
            sub = Wuc .. (GUI.simShares and (" · " .. GUI.simShares) or ""),
            tag = Uuc,
            tagColor = Vuc
        }
    end
    local lvc = Modes.lastScored and Modes.lastScored [1]
    local mvc = lvc and Brain.simRes [lvc.key]
    local nvc = lvc and Brain.simTeam and Brain.simTeam [lvc.key]
    if not lvc then
        return {
            icon = "🔮",
            title = "Simulator",
            text = "waiting for the next pick",
            sub = "",
            tag = ""
        }
    end
    return {
        icon = "🔮",
        title = "Simulator: " .. tostring(lvc.label),
        text = mvc and (tostring(mvc.margin) .. (mvc.playing and (" · " .. tostring(mvc.playing)) or "")) or "no reading yet for this mode",
        sub = nvc and type(nvc.names) == "table" and ("team: " .. table.concat(nvc.names,
        ", ") .. (nvc.why and (" · " .. tostring(nvc.why)) or "")) or "",
        tag = mvc and (mvc.hopeless and "HOPELESS" or string.format("%d%%",
        math.floor((tonumber(lvc.p) or 0) * 100 + 0.5))) or "",
        tagColor = mvc and (mvc.hopeless and Quc.red or ((tonumber(lvc.p) or 0) >= 0.7 and Quc.green or Quc.orange)) or nil
    }
end

