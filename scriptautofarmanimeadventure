function GUI.keyName(Guc)
    if Guc == "dc" then
        return "📅 Daily Challenge"
    end
    if Guc == "ch" then
        return "🏆 Challenge"
    end
    if Guc == "dg" then
        return "🏰 Dungeon"
    end
    local Huc, Iuc, Juc = tostring(Guc):match("^(%a+):([^:]+):?(%a*)$")
    if not Iuc then
        return tostring(Guc)
    end
    return (({
        st = "⚔️ ",
        rd = "👹 ",
        ev = "🃏 ",
        inf = "♾️ "
    }) [Huc] or "") .. Modes.levelName(Iuc) .. ((Juc and Juc ~= "") and (" " .. Juc) or "")
end

function GUI.plainMode(Kuc)
    return string.format("%s · %.0f%% win · ≈%.0f gems/min", Kuc.label, (Kuc.p or 0) * 100, Kuc.score or 0)
end

function GUI.upNext(Luc, Muc)
    if not Luc then
        return "deciding…", ""
    end
    if App.where == "match" and Luc.kind == "story" and Luc.first and Luc.key == Match.key then
        local Nuc = "once this act is won. If it's lost, this act again"
        local Ouc, Puc = pcall(Core.PSC.get_next_story_level, Luc.level)
        if Config.onlyStory and Ouc and Puc then
            return Modes.levelName(Puc) .. " (" .. tostring(Luc.diff) .. ")", "The next act, " .. Nuc
        end
        if Muc then
            return GUI.plainMode(Muc), "The next best mode, " .. Nuc
        end
    end
    return GUI.plainMode(Luc), Luc.why or ""
end
GUI.STYLE_NAMES = {
    fast = "fast clear, at the road's start",
    balanced = "spread out along the road",
