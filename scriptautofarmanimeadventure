Match.IDOL_PRIOR = {
    dmg = 0.05,
    cost = 0.05
}

function Match.idolStep()
    local vbc = Brain.fh.idol
    local wbc, xbc = Match.IDOL_PRIOR.dmg, Match.IDOL_PRIOR.cost
    if vbc and vbc.n > 0 then
        wbc, xbc = vbc.dmg / vbc.n, vbc.cost / vbc.n
    end
    return math.max(0, wbc) + math.max(0, xbc) * 0.5
end

function Match.idolMeasure()
    local ybc
    for zbc, Abc in ipairs(Match.mine) do
        local Bbc = Abc._stats.id.Value
        local Cbc = Abc._stats:FindFirstChild("damage")
        if not Units.isFarm(Bbc) and not Units.idol(Bbc) and Cbc and Cbc.Value > 0 then
            ybc = Abc
            break
        end
    end
    if not ybc then
        return
    end
    local Dbc = ybc._stats
    local function Ebc()
        local Fbc, Gbc = pcall(Core.USC.calculate_upgrade_cost_multiplier, ybc, Core.session())
        local Hbc = Dbc:FindFirstChild("buff_damage_multiplier") and tonumber(Dbc.buff_damage_multiplier.Value) or 0
        return Dbc.damage.Value * (1 + Hbc), Fbc and tonumber(Gbc) or nil
    end
    local Ibc, Jbc = Ebc()
    local Kbc = Dbc.upgrade.Value
    task.delay(3, function()
        if not ybc.Parent or Dbc.upgrade.Value ~= Kbc then
            return
        end
        local Lbc, Mbc = Ebc()
        if not (Jbc and Mbc and Jbc > 0 and Ibc > 0) then
            return
        end
        if Lbc == Ibc and Mbc == Jbc then
            return App.log(2, "UPGRADE", "Idol upgrade: no change seen yet, not counted")
        end
        local Nbc = Brain.fh.idol or {
            n = 0,
            dmg = 0,
            cost = 0
        }
        Nbc.n, Nbc.dmg, Nbc.cost = Nbc.n + 1, Nbc.dmg + (Lbc / Ibc - 1), Nbc.cost + (1 - Mbc / Jbc)
        Brain.fh.idol = Nbc
        App.log(1, "UPGRADE", string.format("Idol upgrade measured on %s: %+.1f%% damage, upgrades %.1f%% cheaper", Units.name(Dbc.id.Value), (Lbc / Ibc - 1) * 100, (1 - Mbc / Jbc) * 100))
    end)
end

function Match.spells()
    local Obc = Core.session()
    local Pbc = Obc and Obc.ingame_spells
    if type(Pbc) ~= "table" or Match.spellBusy then
        return
    end
    local Qbc = Match.money()
    local Rbc = (Match.pressure or 0) >= math.min(Config.dangerReach, ((Match.depth and Match.depth.units > 0 and Match.depth.covEnd) or 1) * 0.9)
    local Sbc, Tbc, Ubc
    for Vbc, Wbc in ipairs(Match.mine) do
        local Xbc = Wbc._stats.id.Value
        if not Units.isFarm(Xbc) and not Units.allyBuff(Xbc) and Xbc ~= "mahoraga" then
            local Ybc, Zbc = pcall(Match.liveDps, Wbc, Xbc)
            local _bc = Ybc and Zbc and Zbc * Match.airBoost(Wbc) * Match.reach(Wbc)
            if _bc and (not Ubc or _bc > Ubc) then
                Sbc, Tbc, Ubc = Wbc, Zbc, _bc
            end
        end
    end
    local acc = Match.mergePlan
    local bcc = {
    }
    for ccc, dcc in pairs(Pbc) do
        table.insert(bcc, {
            slot = ccc,
            spell = dcc,
            rank = Match.SPELL_ORDER [dcc] or 9
        })
    end
    table.sort(bcc, function(ecc, fcc)
        return ecc.rank < fcc.rank
    end)
    Match.spellWant = nil
    Match.cloneNote = nil
    for gcc, hcc in ipairs(bcc) do
        local icc, jcc = hcc.slot, hcc.spell
        local kcc, lcc
        local mcc
        for ncc, occ in ipairs(Match.mine) do
            if occ._stats.id.Value == "mahoraga" then
                mcc = occ
            end
        end
        local pcc = mcc and (Match.buffCount [mcc] or 0) < 2
        if jcc == "random_buff" and Qbc >= 1000 and (pcc or Sbc) then
            if pcc then
                kcc, lcc = mcc, "the Divine General (two buffs make it a boss killer; its range is only 8.5)"
            else
                kcc, lcc = Sbc, "+100% attack or range on your strongest unit"
            end
        elseif jcc == "sacrifice" and acc and acc.ready then
            if Qbc >= 1000 then
                kcc, lcc = acc.fresh.m, string.format("the %d other cop%s in its range (it keeps 1.5× their damage through its own upgrades)", acc.n, acc.n == 1 and "y" or "ies")
                Match.mergeBefore = {
                    own = acc.fresh.dps,
                    near = acc.near,
                    lvl = acc.fresh.lvl,
                    top = acc.top.lvl
                }
            else
                Match.spellWant = Match.spellWant or {
                    cost = 1000,
                    why = "Merge on " .. Units.name(acc.id)
                }
            end
        elseif jcc == "sacrifice" and Qbc >= 1000 and not Rbc and not (acc and acc.fresh) and Match.farmMergeOk() and Match.farmMergePair() then
            local qcc, rcc, scc = Match.farmMergePair()
            kcc = qcc
            lcc = string.format("the %d other %s in its reach (does a farm keep their income?)", scc, Units.name(qcc._stats.id.Value))
            Match.farmMergeBefore = {
                own = tonumber(qcc._stats.farm_amount.Value) or 0,
                inc = rcc
            }
        elseif jcc == "clone" then
            local tcc = not Rbc and acc and acc.fresh and acc.top.lvl < acc.top.max
            Match.cloneWaitAt = tcc and (Match.cloneWaitAt or Match.wave()) or nil
            local ucc = tcc and Match.wave() - Match.cloneWaitAt < 5
            local vcc, wcc
            if not Rbc and acc and acc.fresh and acc.top.lvl >= acc.top.max then
                vcc, wcc = acc.top.m, "a maxed copy for the Merge to take in"
            elseif not ucc and Sbc then
                vcc, wcc = Sbc, Rbc and "a copy of your strongest unit: instant damage with enemies near the base" or "a copy of your strongest unit (two copies make a Merge)"
            end
            if ucc then
                Match.cloneNote = string.format("waits for %s to max (%d/%d, up to %d more waves)", Units.name(acc.id), acc.top.lvl, acc.top.max, 5 - (Match.wave() - Match.cloneWaitAt))
            end
            if vcc and Qbc >= 5000 then
                kcc, lcc = vcc, wcc
            elseif vcc then
                local xcc, ycc = pcall(Match.liveDps, vcc, vcc._stats.id.Value)
                ycc = xcc and tonumber(ycc) or 0
                if ycc >= (Match.bestRate or 0) * 5000 * 0.5 then
                    Match.spellWant = Match.spellWant or {
                        cost = 5000,
                        why = "Clone of " .. Units.name(vcc._stats.id.Value),
                        rate = ycc / 5000
                    }
                    Match.cloneNote = "saving for a copy of " .. Units.name(vcc._stats.id.Value)
                else
                    Match.cloneNote = string.format("a copy of %s (%s dps) is worth less than ¥5k of upgrades (%s)", Units.name(vcc._stats.id.Value), Utils.fmt(ycc), Utils.fmt((Match.bestRate or 0) * 5000))
                end
            end
        elseif jcc == "ritual" and not Rbc and Match.wave() >= 8 and not Match.hasGeneral() then
            local zcc, Acc = Match.ritualTarget()
            if zcc and Qbc >= 10000 then
                kcc, lcc = zcc, Acc
            elseif zcc then
                Match.spellWant = Match.spellWant or {
                    cost = 10000,
                    why = "a Ritual (" .. Acc .. ")"
                }
            end
        elseif jcc == "summon" and Qbc >= 10000 and not Rbc and Match.summonWorth() then
            kcc, lcc = false, "a unit from your own team"
        elseif jcc == "gate" and Qbc >= 2500 and not Rbc and Match.summonWorth() then
            kcc, lcc = false, "3× the odds of Astral Summon"
        end
        if lcc then
            Match.spellBusy = true
            local Bcc = {
            }
            for Ccc, Dcc in ipairs(workspace._UNITS:GetChildren()) do
                Bcc [Dcc] = true
            end
            local Ecc
            if kcc then
                local Fcc = kcc._stats
                local Gcc, Hcc = pcall(Match.liveDps, kcc, Fcc.id.Value)
                Ecc = {
                    id = Fcc.id.Value,
                    pos = kcc:GetPivot().Position,
                    dps = Gcc and tonumber(Hcc) or 0,
                    lvl = Fcc.upgrade.Value,
                    spent = Fcc:FindFirstChild("total_spent") and tonumber(Fcc.total_spent.Value) or 0
                }
            end
            task.spawn(function()
                local Icc
                if kcc then
                    Icc = App.request("spell", "use_ingame_spell", icc, kcc)
                else
                    Icc = App.request("spell", "use_ingame_spell", icc)
                end
                task.wait(1.5)
                local Jcc = kcc and Units.name(kcc._stats.id.Value) or ""
                if Icc and (Core.session().ingame_spells or {
                }) [icc] ~= jcc then
                    App.log(1, "SPELL", string.format("%s%s — %s", Match.SPELL_NAMES [jcc] or tostring(jcc), kcc and (" on " .. Jcc) or "", lcc))
                    App.status("Abilities", string.format("spell %s%s — %s", Match.SPELL_NAMES [jcc] or tostring(jcc), kcc and (" on " .. Jcc) or "", lcc))
                    if jcc == "sacrifice" then
                        if Ecc and Units.isFarm(Ecc.id) then
                            pcall(Match.farmMergeMeasure, kcc)
                        else
                            pcall(Match.mergeMeasure, kcc)
                        end
                    end
                    if jcc == "random_buff" and kcc then
                        Match.buffCount [kcc] = (Match.buffCount [kcc] or 0) + 1
                    end
                    if (jcc == "clone" or jcc == "ritual") and Ecc then
                        pcall(Match.newUnitMeasure, jcc, kcc, Jcc, Ecc, Bcc)
                    end
                else
                    App.backoff("spell", 15)
                    App.log(2, "SPELL", tostring(jcc) .. " wasn't taken" .. (kcc and (" on " .. Jcc) or ""))
                end
                Match.spellBusy = false
            end)
            return
        end
    end
end

function Match.trainCount()
    local Kcc = Brain.train.on
    if not (Kcc and Match.trainee) then
        return
    end
    local Lcc = 0
    for Mcc, Ncc in ipairs(Match.mine) do
        local Occ = Ncc._stats
        local Pcc = Occ:FindFirstChild("uuid") and Occ.uuid.Value
        local Qcc = Pcc == Match.trainee and Occ:FindFirstChild(Kcc.what == "kills" and "kill_count" or "takedown_count")
        if Qcc then
            Lcc = Lcc + (tonumber(Qcc.Value) or 0)
        end
    end
    Match.trainTk = math.max(Match.trainTk or 0, Lcc)
    App.status("Training", string.format("%s: %d %s this match · %s/%s", Units.name(Kcc.id), Match.trainTk, Kcc.what, Utils.fmt(Kcc.have + (Kcc.got or 0) + Match.trainTk), Utils.fmt(Kcc.need)))
end

function Match.trainDone(Rcc, Scc)
    local Tcc = Brain.train.on
    if not (Tcc and Match.trainee) then
        return
    end
    Match.trainCount()
    local Ucc = Match.trainTk or 0
    Tcc.got = (Tcc.got or 0) + Ucc
    local Vcc = Brain.trainSim [Rcc] and tonumber(Brain.trainSim [Rcc].tk)
    if not Match.joinedMid then
        local Wcc = Brain.train.real [Rcc] or {
            n = 0,
            sum = 0
        }
        Wcc.n, Wcc.sum = Wcc.n + 1, Wcc.sum + Ucc
        Brain.train.real [Rcc] = Wcc
        if Vcc and Vcc > 0 then
            local Xcc = Brain.train.cal
            Xcc.real, Xcc.sim, Xcc.n = (Xcc.real or 0) + Ucc, (Xcc.sim or 0) + Vcc, (Xcc.n or 0) + 1
        end
    end
    table.insert(Brain.train.log, 1, {
        key = Rcc,
        got = Ucc,
        won = Scc,
        at = os.time()
    })
    while # Brain.train.log > 20 do
        table.remove(Brain.train.log)
    end
    App.log(1, "TRAIN", string.format("%s: +%d %s this run (%s%s) · %s/%s", Units.name(Tcc.id), Ucc, Tcc.what, Scc and "won" or "lost", Vcc and string.format(", the simulator said ≈%d", Vcc) or "", Utils.fmt(Training.realHave(Tcc)), Utils.fmt(Tcc.need)))
    if not Scc then
        Brain.train.bad [Rcc] = os.time() + 6 * 3600
        App.log(1, "TRAIN", "the training team lost here: no training in this mode for 6 h")
    end
end

function Match.finish()
    if Match.finished then
        return
    end
    Match.finished = true
    local Ycc
    local Zcc = Utils.now()
    while Utils.now() - Zcc < 8 do
        Ycc = Match.result or (Core.GUIS.results_ui and Core.GUIS.results_ui.settings)
        if Ycc then
            break
        end
        task.wait(0.25)
    end
    local _cc = Ycc and Ycc.victory or false
    local adc = Match.infinite and Match.wave() or nil
    if adc then
        _cc = true
    end
    local bdc = Match.key
    local cdc = Modes.rec(bdc)
    if adc and not Match.joinedMid and not Match.stopping then
        cdc.waveSum, cdc.waveN = (tonumber(cdc.waveSum) or 0) + adc, (tonumber(cdc.waveN) or 0) + 1
        cdc.waveBest = math.max(tonumber(cdc.waveBest) or 0, adc)
    end
    if adc and (tonumber(Brain.infResults) or 0) < 3 and type(Ycc) == "table" then
        Brain.infResults = (tonumber(Brain.infResults) or 0) + 1
        local ddc = {
        }
        for edc, fdc in pairs(Ycc) do
            table.insert(ddc, type(fdc) == "table" and (edc .. "{…}") or (edc .. "=" .. tostring(fdc)))
        end
        table.sort(ddc)
        App.log(1, "MATCH", "Infinite result fields: " .. table.concat(ddc, ", "))
    end
    local gdc = Ycc and Ycc.stats and tonumber(Ycc.stats.time_taken) or (os.clock() - (Match.startClock or os.clock()))
    local hdc = Ycc and ((tonumber(Ycc.gem_reward) or 0) + (tonumber(Ycc.first_completion_gems) or 0)) or 0
    local idc = Core.GS.CURRENT_EVENT_RESOURCE or "AprilCoins"
    local jdc = Ycc and Ycc.resource_reward and tonumber(Ycc.resource_reward [idc]) or 0
    if not Match.joinedMid then
        cdc.runs = cdc.runs + 1
        if _cc then
            cdc.wins = cdc.wins + 1
            cdc.streak = 0
        elseif Match.kind == "event" and jdc > 0 then
            cdc.streak = 0
        else
            cdc.streak = (cdc.streak or 0) + 1
        end
        cdc.sec = cdc.sec + gdc
        cdc.timed = (tonumber(cdc.timed) or 0) + 1
    end
    if _cc then
        if Match.ld._gamemode == "story" or Match.kind == "raid" then
            Brain.cleared [Match.ld.id .. ":" .. tostring(Match.ld._difficulty or "Normal")] = os.time()
        end
        if bdc == "ch" and Brain.live.normal then
            Brain.live.normal.doneUuid = Brain.live.normal.uuid
        end
        if bdc == "dc" and Brain.live.daily then
            Brain.live.daily.doneUuid = Brain.live.daily.uuid
        end
    end
    for kdc, ldc in pairs(Brain.cleared) do
        if os.time() - ldc > 86400 then
            Brain.cleared [kdc] = nil
        end
    end
    cdc.gems = cdc.gems + hdc
    cdc.coins = cdc.coins + jdc
    cdc.last = os.time()
    local mdc = (cdc.streak or 0) >= Config.restAfterLosses and Match.kind ~= "dungeon" and Match.kind ~= "portal" and not Match.trialId and not (Config.dailyLoop and bdc == "dc")
    if mdc then
        cdc.restUntil, cdc.restWhy = os.time() + 6 * 3600, "losses"
        App.log(1, "MODE", Match.label() .. ": lost " .. cdc.streak .. " in a row — resting it for 6 h")
    end
    if not _cc and (bdc == "ch" or bdc == "dc") then
        local ndc = bdc == "ch" and Brain.live.normal or Brain.live.daily
        if ndc then
            ndc.lost = (ndc.lost or 0) + 1
        end
    end
    Brain.totals.matches = (Brain.totals.matches or 0) + 1
    if not Match.joinedMid then
        if _cc then
            Brain.totals.wins = Brain.totals.wins + 1
        else
            Brain.totals.losses = Brain.totals.losses + 1
        end
    end
    Brain.totals.gems = (Brain.totals.gems or 0) + hdc
    Brain.totals.coins = (Brain.totals.coins or 0) + jdc
    local odc = {
    }
    for pdc, qdc in pairs(Ycc and Ycc.new_items or {
    }) do
        local rdc = type(qdc) == "table" and (qdc.item_id or qdc.id) or tostring(qdc)
        odc [rdc] = (odc [rdc] or 0) + (type(qdc) == "table" and tonumber(qdc.amount) or 1)
    end
    local sdc = Match.label()
    if Match.kind == "dungeon" and not Match.joinedMid then
        local tdc, udc = pcall(Dungeon.roomDone, _cc)
        if not tdc then
            App.log(1, "ERROR", "dungeon: " .. tostring(udc))
        end
    end
    if not Match.joinedMid and not Match.random and not Match.stopping and not Match.trialId then
        pcall(Match.spotResult, _cc)
    end
    Brain.lastResult = {
        won = _cc,
        text = string.format("%s · %s · wave %s · %dm%02ds",
        sdc,
        _cc and "won" or "lost",
        tostring(Ycc and Ycc.stats and Ycc.stats.waves_completed or Match.wave()),
        math.floor(gdc / 60),
        math.floor(gdc % 60)),
        gems = hdc,
        coins = jdc,
        items = odc,
        at = os.time()
    }
    table.insert(Brain.history, 1, {
        key = bdc,
        won = _cc,
        sec = gdc,
        gems = hdc,
        coins = jdc,
        at = os.time()
    })
    while # Brain.history > 30 do
        table.remove(Brain.history)
    end
    Brain.lastMatch = {
        label = sdc,
        spent = Match.spent,
        actions = # Match.actions,
        refusals = Match.refusals or 0,
        at = os.time()
    }
    if not Match.trialId then
        pcall(Match.learn)
    end
    local vdc, wdc = pcall(Match.trainDone, bdc, _cc)
    if not vdc then
        App.log(1, "ERROR", "training: " .. tostring(wdc))
    end
    local xdc, ydc = true, nil
    if Match.hunt then
        local zdc, Adc = pcall(Match.huntRecord, Ycc, jdc, _cc, gdc)
        if not zdc then
            App.log(1, "ERROR", "hunt record: " .. tostring(Adc))
        end
    end
    if Match.random then
        pcall(Match.fhRecord, jdc, _cc)
    elseif not Match.stopping and not Match.trialId then
        xdc, ydc = pcall(Match.calMerge, _cc)
    end
    if not xdc then
        App.log(1, "ERROR", "sim calibration: " .. tostring(ydc))
    end
    Reports.record({
        mode = bdc,
        won = _cc,
        sec = math.floor(gdc),
        wave = Match.wave(),
        gems = hdc,
        coins = jdc,
        mid = Match.joinedMid or nil
    })
    App.log(1, "RESULT", string.format("%s — %s, +%d gems%s, ¥%s spent, %d refused spots", sdc, adc and ("reached wave " .. adc) or (_cc and "WON" or "LOST"), hdc, jdc > 0 and (", +" .. jdc .. " " .. idc) or "", Utils.fmt(Match.spent), Match.refusals or 0))
    if Brain.watch and Brain.watch.key == bdc then
        Brain.watch.won = _cc and true or false
        App.saveNow()
    end
    local Bdc = Brain.testTeam
    local Cdc = Bdc and (Bdc.left or 0) > 0 and Bdc.key == bdc and type(Bdc.uuids) == "table" and Training.same(Training.team(), Bdc.uuids)
    if Bdc and (Bdc.left or 0) > 0 and Bdc.key == bdc then
        Bdc.left = Bdc.left - 1
        Bdc.runs = Bdc.runs or {
        }
        local Ddc = Match.damageLine() or ""
        table.insert(Bdc.runs, {
            won = _cc,
            wave = Match.wave(),
            sec = gdc,
            at = os.time(),
            dmg = Ddc,
            other = not Cdc or nil
        })
        App.log(1, "TEST", string.format("%s: run %d of %d %s at wave %d in %.1f min%s · %s", tostring(Bdc.label), # Bdc.runs, tonumber(Bdc.n) or # Bdc.runs, _cc and "WON" or "LOST", Match.wave(), (tonumber(gdc) or 0) / 60, Cdc and "" or " (the test team wasn't on: not counted)", Ddc))
        if Bdc.left <= 0 then
            App.log(1, "TEST", tostring(Bdc.label) .. ": done, the usual team picking is back")
        end
        App.saveSoon()
    end
    pcall(function()
        if Cdc then
            return
        end
        local Edc = Modes.rec(bdc)
        if _cc and not adc then
            local Fdc = {
            }
            for Gdc, Hdc in ipairs(Units.equipped()) do
                table.insert(Fdc, Hdc.uuid)
            end
            table.sort(Fdc)
            local Idc = table.concat(Fdc, ",")
            local function Jdc(Kdc)
                local Ldc, Mdc = Core.session(), 0
                for Ndc, Odc in ipairs(Kdc or {
                }) do
                    local Pdc = Ldc.collection:get_unit_by_uuid(Odc)
                    local Qdc, Rdc = pcall(Units.score, Pdc or {
                    })
                    Mdc = Mdc + (Qdc and Rdc or 0)
                end
                return Mdc
            end
            if # Fdc > 0 then
                if Edc.winSig == Idc then
                    Edc.winTeamN = (tonumber(Edc.winTeamN) or 0) + 1
                elseif not Edc.winTeam or Jdc(Fdc) >= Jdc(Edc.winTeam) then
                    Edc.winTeam, Edc.winSig, Edc.winTeamN = Fdc, Idc, 1
                end
            end
        elseif not _cc then
            Edc.winTeam, Edc.winSig, Edc.winTeamN = nil, nil, nil
        end
    end)
    local Sdc, Tdc = pcall(Reports.match, {
        key = bdc,
        won = _cc,
        sec = gdc,
        gems = hdc,
        coins = jdc,
        items = odc
    })
    if not Sdc then
        App.log(1, "ERROR", "local learning: " .. tostring(Tdc))
    end
    if Match.kind == "portal" then
        pcall(function()
            local Udc = {
            }
            for Vdc, Wdc in ipairs(Units.equipped()) do
                table.insert(Udc, Units.name(Wdc.id))
            end
            local Xdc = Match.pred
            FarmHub.portalLine(string.format("%s · %s at wave %d of %d · predicted %s · team: %s · style %s · modifiers: %s · %s", os.date("%m-%d %H:%M"), _cc and "WON" or "LOST", Match.wave(), Match.total or 0, Xdc and ((Xdc.won and "a win at " or "a loss at ") .. tostring(Xdc.wave)) or "nothing", table.concat(Udc, ", "), tostring(Match.style), tostring(Brain.portalMods or "?"):sub(1, 300), tostring(Match.damageLine() or "")))
        end)
    end
    for Ydc, Zdc in pairs(Match.buffSeen) do
        local _dc = 0
        for aec, bec in ipairs(Zdc.levels) do
            _dc = math.max(_dc, bec)
        end
        App.log(1, "BUFF", string.format("%s cast %d times: your units read %s%% after the casts (highest +%d%%)", Units.name(Ydc), Zdc.casts, table.concat(Zdc.levels, ", "), _dc))
        local cec = Units.allyBuff(Ydc)
        if cec and cec.attack then
            local dec = 0
            for eec, fec in pairs(cec.types or {
            }) do
                dec = math.max(dec, tonumber(fec) or 0)
            end
            local gec = Brain.stack [cec.attack]
            if dec > 0 and _dc / 100 > dec + 0.05 and not (gec and gec.stacks and (tonumber(gec.cap) or 0) >= _dc / 100) then
                Brain.stack [cec.attack] = {
                    stacks = true,
                    cap = math.max(gec and gec.stacks and tonumber(gec.cap) or 0,
                    _dc / 100),
                    before = dec,
                    after = _dc / 100,
                    at = os.time(),
                    seen = true
                }
                App.log(1, "BUFF", string.format("%s's buffs stack: +%d%% with one, +%d%% seen with more. Copies now chain up to that", Units.name(Ydc), math.floor(dec * 100 + 0.5), _dc))
            end
        end
    end
    local hec, iec = pcall(Match.damageLine)
    if hec and iec then
        App.log(1, "DAMAGE", iec)
    end
    if not Match.random then
        local jec, kec, lec = pcall(Match.damageShares)
        if jec and kec and not Match.trialId then
            pcall(Strategy.learn, kec, Match.team)
        end
        local mec, nec = pcall(Match.summonSplit)
        if mec and nec and jec and (lec or 0) > 0 then
            Brain.str.summon = type(Brain.str.summon) == "table" and Brain.str.summon or {
            }
            for oec, pec in pairs(nec) do
                if pec.total >= 0.01 * lec then
                    local qec = Brain.str.summon [oec]
                    local tec = (type(qec) == "table" and tonumber(qec.n) or 0) + 1
                    local uec = math.max(0.2, 1 / tec)
                    Brain.str.summon [oec] = {
                        s = type(qec) == "table" and (qec.s + (pec.share - qec.s) * uec) or pec.share,
                        n = tec
                    }
                end
            end
        end
        Brain.lastRun = {
            key = bdc,
            at = os.time(),
            xp0 = Match.xp0
        }
    end
    if Match.trialId then
        local vec, wec = pcall(Match.trialDone, _cc, gdc)
        if not vec then
            App.log(1, "ERROR", "trial: " .. tostring(wec))
            Brain.trial = nil
        end
    end
    local xec
    if _cc and Match.ld._is_actual_storymode then
        local yec, zec = pcall(Core.PSC.get_next_story_level, Match.ld.id)
        if yec and zec then
            xec = zec
            local Aec = Utils.now()
            while App.alive and Utils.now() - Aec < 2 do
                if Modes.open(zec) then
                    break
                end
                task.wait(0.5)
            end
        end
    end
    local Bec = nil
    pcall(function()
        Bec = Modes.pick()
    end)
    if Bec and Bec.kind == "story" and Bec.first and xec and Bec.level ~= xec and not Brain.nextMode then
        for Cec, Dec in ipairs(Modes.lastScored or {
        }) do
            if Dec.kind == "story" and Dec.first and Dec.level == xec and Dec.diff == Match.ld._difficulty and (Dec.baseScore or Dec.score or 0) >= (Bec.baseScore or Bec.score or 0) * Modes.CHAIN_MIN then
                Bec = Dec
                break
            end
        end
    end
    if not Bec and xec and Config.onlyStory and (Config.pickStory == "" or Config.pickStory == "progress") and Match.ld._difficulty == "Normal" and not Modes.done((Core.prof() or {
    }).level_data or {
    }, xec, "Normal") then
        local Eec = "st:" .. xec .. ":Normal"
        Bec = {
            key = Eec,
            kind = "story",
            first = true,
            level = xec,
            diff = "Normal",
            label = Modes.levelName(xec) .. " (Normal)",
            rec = Modes.rec(Eec)
        }
    end
    local Fec, Gec = "lobby", "back to the lobby"
    local Hec = (Match.ld._gamemode == "story" or Match.ld._gamemode == "infinite" or (Match.kind == "event" and Match.ld._OVERRIDE_CAN_REPLAY)) and _cc
    if not Config.play or not Config.master then
        Fec, Gec = "stay", "Auto Play is off"
    elseif Bec and Bec.key == bdc and Hec then
        Fec, Gec = "replay", "replaying: still the best mode"
    elseif Bec and Bec.kind == "story" and Match.ld._is_actual_storymode and _cc then
        local Iec, Jec = pcall(Core.PSC.get_next_story_level, Match.ld.id)
        if Iec and Jec == Bec.level and Bec.diff == Match.ld._difficulty then
            Fec, Gec = "next_story", "next act: " .. Bec.label
        end
    end
    if Fec ~= "replay" and Fec ~= "next_story" and Bec then
        Gec = "lobby for: " .. Bec.label
    end
    local Kec = Brain.train.on
    if Kec and Match.trainee and (Fec == "replay" or Fec == "next_story") and Training.realHave(Kec) >= Kec.need then
        Fec, Gec = "lobby", "lobby: " .. Units.name(Kec.id) .. " has its " .. tostring(Kec.what) .. ", your own team goes back in"
    end
    if Brain.holdLobby and Fec ~= "stay" then
        Fec, Gec = "lobby", "lobby: held there: " .. tostring(Brain.holdLobby.why)
    end
    if (Fec == "replay" or Fec == "next_story") and Bec then
        local Lec, Mec = pcall(FarmHub.matchOn, Bec)
        if Lec and Mec then
            Fec, Gec = "lobby", "lobby: matchmaking again for " .. tostring(Bec.label)
        end
    end
    if (Fec == "replay" or Fec == "next_story") and Config.smartCharm and Bec then
        local Nec, Oec = pcall(Hunt.charmWant, Bec)
        if Nec and Oec then
            Fec, Gec = "lobby", "lobby: putting on the Summer Charm (" .. Hunt.charmWords(Oec) .. ")"
        end
    end
    if Match.trialId and Fec ~= "stay" then
        Fec, Gec = "lobby", Brain.trial and "lobby: the next trial run" or "lobby: your own team goes back in"
    end
    if Brain.buyStorage and Fec ~= "stay" then
        Fec, Gec = "lobby", "lobby: buying the unit storage you agreed"
    end
    if Brain.buyOnce and Fec ~= "stay" then
        Fec, Gec = "lobby", "lobby: buying the " .. tostring((Core.Items [Brain.buyOnce.item] or {
        }).name or Brain.buyOnce.item) .. " you agreed"
    end
    local Pec
    if ((Match.kind == "dungeon" and _cc) or Fec == "next_story" or Fec == "replay") and Fec ~= "stay" then
        local Qec, Rec = pcall(Strategy.hasWork)
        if Qec then
            Pec = Rec
        else
            App.log(1, "ERROR", "team work: " .. tostring(Rec))
        end
        if Pec then
            Fec, Gec = "lobby", "lobby: the Units → Upgrades can " .. tostring(Pec)
        end
    end
    if Match.kind == "dungeon" and Fec ~= "stay" and Bec and Bec.key == "dg" and _cc and # Units.equipped() >= 6 and not Brain.holdLobby and not Brain.buyStorage and not Pec then
        Brain.pending = nil
        App.saveNow()
        App.status("Match", "next dungeon room")
        local Sec, Tec = pcall(Dungeon.chain)
        if not Sec then
            App.log(1, "ERROR", "dungeon next room: " .. tostring(Tec))
        end
        if Sec and Tec then
            return
        end
        Brain.startTeam = nil
        Fec, Gec = "lobby", "lobby: the next dungeon room didn't start from here"
    end
    Brain.pending = (Fec == "replay" or Fec == "next_story") and {
        key = Bec.key,
        kind = Bec.kind,
        level = Bec.level,
        diff = Bec.diff,
        label = Bec.label,
        at = os.time()
    } or nil
    if Fec == "next_story" or Fec == "replay" then
        Brain.startTeam = {
            train = {
                key = Bec.key,
                kind = Bec.kind,
                first = Bec.first,
                level = Bec.level,
                diff = Bec.diff,
                label = Bec.label
            },
            why = (Fec == "replay" and "replay: " or "next act: ") .. tostring(Bec.label)
        }
    end
    App.saveNow()
    App.status("Match", Gec)
    App.log(1, "MODE", Gec)
    if Fec == "stay" then
        return
    end
    task.wait(2.5)
    if Fec == "replay" or Fec == "next_story" then
        local Uec = ReplicatedStorage.endpoints.server_to_client
        local Vec, Wec = false, false
        local Xec = Uec.match_rematch_started.OnClientEvent:Connect(function()
            Vec = true
        end)
        local Yec = Uec.match_rematch_ready.OnClientEvent:Connect(function()
            Wec = true
        end)
        table.insert(App.conns, Xec)
        table.insert(App.conns, Yec)
        App.request("vote", "set_game_finished_vote", Fec)
        local Zec = Utils.now()
        while App.alive and Utils.now() - Zec < 30 and not Vec do
            task.wait(0.25)
        end
        if Vec then
            local _ec = Utils.now()
            while App.alive and Utils.now() - _ec < 60 and not Wec do
                task.wait(0.25)
            end
            if App.alive then
                App.log(1, "MODE", string.format("the match restarted in place in %.0f s (%s)", Utils.now() - Zec, Fec))
                local afc, bfc = pcall(App.restart)
                if afc then
                    return
                end
                App.log(1, "ERROR", "couldn't start again in place: " .. tostring(bfc))
            else
                return
            end
        end
    end
    if App.alive then
        App.request("lobby", "teleport_back_to_lobby")
    end
end

function Match.watchMods()
    local cfc = workspace:FindFirstChild("ignore")
    if not cfc then
        return
    end
    local dfc = {
    }
    local efc, ffc = - 9, false
    local Jfc = cfc.ChildAdded:Connect(function(gfc)
        task.defer(function()
            local hfc = gfc:FindFirstChild("Gui")
            if not (hfc and gfc:IsA("BasePart")) then
                return
            end
            local ifc, jfc
            for kfc, lfc in ipairs(workspace._UNITS:GetChildren()) do
                local mfc = lfc:FindFirstChild("HumanoidRootPart")
                if mfc then
                    local nfc = (mfc.Position - gfc.Position).Magnitude
                    if nfc < 4 and (not jfc or nfc < jfc) then
                        ifc, jfc = lfc, nfc
                    end
                end
            end
            local ofc = ifc and ifc:FindFirstChild("_stats")
            if not (ofc and ofc:FindFirstChild("Armor")) then
                return
            end
            local pfc = ofc:FindFirstChild("player")
            if pfc and pfc.Value ~= nil then
                return
            end
            local qfc = {
            }
            for rfc, sfc in ipairs({
                "Armor",
                "Ice",
                "Flying",
                "Soaring"
            }) do
                local tfc = ofc:FindFirstChild(sfc)
                qfc [sfc] = tfc and (tonumber(tfc.Value) or 0) > 0
            end
            if qfc.Flying or qfc.Soaring then
                return
            end
            local ufc = (qfc.Armor and not qfc.Ice and "Armor") or (qfc.Ice and not qfc.Armor and "Ice") or ((not qfc.Armor and not qfc.Ice) and "plain") or nil
            if not ufc then
                return
            end
            if ufc == "Ice" then
                if os.clock() - efc > 2 then
                    efc, ffc = os.clock(), Hunt.is(Match.ld and Match.ld.id) and Hunt.weatherNow() == "snow"
                end
                if ffc then
                    ufc = "Ice@snow"
                end
            end
            local vfc = os.clock()
            for wfc, xfc in ipairs(hfc:GetChildren()) do
                local yfc = tonumber(xfc:GetAttribute("final_damage"))
                if yfc and yfc > 1 then
                    local zfc, Afc = false, xfc:FindFirstChild("text")
                    for Bfc, Cfc in ipairs(Afc and Afc:GetChildren() or {
                    }) do
                        if Cfc:IsA("ImageLabel") then
                            zfc = true
                        end
                    end
                    local Dfc = xfc.Name
                    local Efc = {
                        at = vfc,
                        t = Dfc,
                        dmg = yfc,
                        crit = xfc:GetAttribute("is_crit") and true or false,
                        kind = ufc,
                        icon = zfc,
                        res = tonumber(ofc:GetAttribute("_dmg_res_" .. Dfc)) or 0,
                        weak = (tonumber(ofc:GetAttribute("_dmg_weak_" .. Dfc)) or 0) + (tonumber(ofc:GetAttribute("_dmg_amp_" .. Dfc)) or 0)
                    }
                    if not (ufc ~= "Armor" and ufc ~= "plain" and Dfc:find("fire")) then
                        for Ffc, Gfc in ipairs(dfc) do
                            if vfc - Gfc.at < 0.05 and Gfc.t == Dfc and Gfc.crit == Efc.crit and Gfc.res == Efc.res and Gfc.weak == Efc.weak then
                                local Hfc = (Efc.kind ~= "plain" and Efc.icon and Efc) or (Gfc.kind ~= "plain" and Gfc.icon and Gfc) or nil
                                local Ifc = (Efc.kind == "plain" and not Efc.icon and Efc) or (Gfc.kind == "plain" and not Gfc.icon and Gfc) or nil
                                if Hfc and Ifc then
                                    Match.modPair(Hfc.kind, Hfc.dmg / Ifc.dmg)
                                end
                            end
                        end
                    end
                    table.insert(dfc, Efc)
                end
            end
            while dfc [1] and vfc - dfc [1].at > 0.2 do
                table.remove(dfc, 1)
            end
        end)
    end)
    table.insert(App.conns, Jfc)
end

function Match.modPair(Kfc, Lfc)
    if Lfc <= 0.02 or Lfc >= 1.2 then
        return
    end
    local Mfc = Brain.enemyMods [Kfc] or {
        r = {
        }
    }
    Brain.enemyMods [Kfc] = Mfc
    table.insert(Mfc.r, Lfc)
    while # Mfc.r > 80 do
        table.remove(Mfc.r, 1)
    end
    local Nfc = Simulator.modRead(Mfc)
    local Ofc = Mfc.said and Nfc and math.abs(Nfc - Mfc.said) <= Mfc.said * 0.1
    if Nfc and not Ofc then
        Mfc.said = Nfc
    end
    local Pfc, Qfc = Kfc == "Armor" and "Armored" or (Kfc == "Ice@snow" and "Ice (Blizzard)" or "Ice"), Kfc == "Armor" and "from full-area attacks" or "from everything but fire"
    if Nfc and not Ofc then
        App.log(1, "MATCH", string.format("%s enemies measured from %d real hits: they take ×%.2f %s", Pfc, # Mfc.r, Nfc, Qfc))
    end
    if Nfc == false and not Mfc.saidLoose then
        Mfc.saidLoose = true
        local Rfc = table.clone(Mfc.r)
        table.sort(Rfc)
        App.log(1, "MATCH", string.format("%s enemies: %d real hits so far disagree (×%.2f to ×%.2f), so the simulator doesn't count them until they agree", Pfc, # Rfc, Rfc [1], Rfc [# Rfc]))
    end
end

function Match.startTeam()
    local Sfc = Brain.startTeam
    if type(Sfc) ~= "table" then
        return
    end
    Brain.startTeam = nil
    App.saveSoon()
    App.listenGame()
    if Sfc.train and Sfc.train.key ~= Match.key then
        return
    end
    if Sfc.seed and tostring(Brain.dg.room and Brain.dg.room.seed) ~= tostring(Sfc.seed) then
        return
    end
    local function Tfc(Ufc)
        Match.noBuy = true
        Brain.pending = nil
        App.log(1, "TEAM", string.format("%s: no wave started, back to the lobby (%s)", tostring(Ufc), tostring(Sfc.why)))
        App.saveNow()
        for Vfc = 1, 3 do
            App.request("lobby", "teleport_back_to_lobby")
            local Wfc = Utils.now()
            while App.alive and Utils.now() - Wfc < 5 do
                task.wait(0.5)
            end
        end
    end
    if workspace._DATA.GameStarted.Value then
        App.log(1, "TEAM", "too late for a team change before the first wave: " .. tostring(Sfc.why))
        if Sfc.must and not Training.same(Training.team(), Sfc.uuids) then
            Tfc("the first wave had already started")
        end
        return
    end
    local Xfc = Utils.now()
    local Yfc = Training.team()
    local Zfc, _fc = pcall(function()
        if Sfc.train then
            Sfc.train.rec = Modes.rec(Sfc.train.key)
            Sfc.train.ldOverride = Simulator.slim(Match.ld)
            if Config.autoTeam then
                FarmHub.teamFor(Sfc.train, FarmHub.QUICK_SEARCH)
            end
            Training.apply(Sfc.train)
        elseif Sfc.home then
            Training.home()
        elseif Sfc.own then
            FarmHub.restoreTeam()
        else
            FarmHub.equipTeam(Sfc.uuids, tostring(Sfc.why))
        end
    end)
    local agc = Training.team()
    local bgc = not Training.same(Yfc, agc)
    local cgc = App.gameSaid(Xfc)
    if bgc or not Zfc or cgc then
        App.log(1, "TEAM", string.format("team change before the first wave (%s): %s in %.1f s%s%s", tostring(Sfc.why), bgc and "the game took it" or "nothing changed", Utils.now() - Xfc, cgc and (" · the game said: " .. tostring(cgc)) or "", Zfc and "" or (" · error: " .. tostring(_fc))))
    end
    if Sfc.must then
        if not Zfc or # agc < 6 or not Training.same(agc, Sfc.uuids) then
            Tfc(string.format("the team for this room didn't go on (%d of 6 units right)", (function()
                local dgc = 0
                for egc, fgc in ipairs(agc) do
                    if table.find(Sfc.uuids, fgc) then
                        dgc = dgc + 1
                    end
                end
                return dgc
            end)()))
            return false
        end
        local ggc, hgc = pcall(Strategy.relicsApply)
        if not ggc then
            App.log(1, "ERROR", "relics: " .. tostring(hgc))
        end
    end
    return bgc
end

