    local _qc = Zqc and tonumber(Brain.fuseInfo.requirement) or 12
    local arc = Zqc and tonumber(Brain.fuseInfo.divine_wish) or 1
    local brc, crc = Strategy.level(Wqc), Strategy.cap(Wqc)
    local drc
    if # (Config.fuseFodder or {
    }) > 0 then
        _, drc = FarmHub.fodderPicked(Wqc)
    else
        _, drc = FarmHub.fuseFuel(Wqc, _qc)
    end
    local erc = Adventure.have("divine_wish")
    local frc = brc >= crc and erc >= arc and drc >= _qc and not (Zqc and Brain.fuseInfo.allowed == false)
    local hrc = function(grc)
        return grc and "✓" or "✗"
    end
    return {
        icon = "🔥",
        title = Units.name(Wqc.unit_id) .. (Zqc and Brain.fuseInfo.allowed == false and " · can't be limit broken" or ""),
        text = string.format("Level %d/%d %s   ·   Divine Wish %d/%d %s   ·   Fodder %d/%d points %s%s",
        brc,
        crc,
        hrc(brc >= crc),
        erc,
        arc,
        hrc(erc >= arc),
        drc,
        _qc,
        hrc(drc >= _qc),
        Zqc and "" or " (requirement checked in the lobby)"),
        sub = FarmHub.pickNote.autoFuse or (Config.autoFuse and "Auto Limit Break is on: it fuses once everything is ✓, after showing what it uses for 30 s." or "Limit break is off. Review the fodder, then enable it in the target panel."),
        tag = frc and "READY" or "WAITING",
        tagColor = frc and Uqc.green or Uqc.orange,
        progress = math.min(1,
        drc / math.max(1,
        _qc)),
        color = frc and Uqc.green or Uqc.accent
    }
end

function GUI.homeRows()
    local function irc(jrc)
        local krc = tostring(jrc or ""):match("^[^\n]+") or ""
        if # krc > 130 then
            krc = krc:sub(1, 127):gsub("%s+%S*$", "") .. "…"
        end
        return krc
    end
    local function lrc(mrc)
        local nrc, orc = pcall(mrc)
        return nrc and irc(orc) or "…"
    end
    local prc = {
    }
    prc.Playing = Modes.onlyOn() and ("Only " .. Modes.onlyText()) or "Smart: whatever pays best (Farm → Stages)"
    prc.Focus = lrc(FarmHub.focusText)
    prc.Training = Config.trainTakedowns and lrc(Training.text) or "off"
    prc.Snipe = Config.snipeOn and Config.snipeUnit ~= "" and lrc(FarmHub.snipeText) or "off"
    if Config.fuseUnit ~= "" then
        local qrc, rrc = pcall(GUI.lbStatus)
        prc ["Limit Break"] = qrc and irc(rrc.title .. " · " .. tostring(rrc.tag):lower() .. " · " .. (tostring(rrc.text):gsub("%s+·%s+", " · "))) or "…"
    else
        prc ["Limit Break"] = "Choose a target in Units → Fusion"
    end
    prc.Team = Config.team and lrc(Strategy.text) or "off"
    return prc
end
