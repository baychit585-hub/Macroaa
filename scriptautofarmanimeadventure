function Reports.fit(Sjc)
    local Tjc = Utils.json(Sjc)
    if # Tjc <= 3900 then
        return Tjc
    end
    for Ujc, Vjc in ipairs({
        2,
        5,
        10
    }) do
        local Wjc = {
        }
        for Xjc, Yjc in ipairs(Sjc.waves or {
        }) do
            if Xjc % Vjc == 0 or Xjc == # Sjc.waves then
                table.insert(Wjc, Yjc)
            end
        end
        Sjc.waves = Wjc
        Tjc = Utils.json(Sjc)
        if # Tjc <= 3900 then
            return Tjc
        end
    end
    for Zjc, _jc in ipairs(Sjc.placed or {
    }) do
        _jc.why = nil
    end
    Tjc = Utils.json(Sjc)
    if # Tjc <= 3900 then
        return Tjc
    end
    if Sjc.mapData then
        Sjc.mapData.dens = nil
    end
    Tjc = Utils.json(Sjc)
    if # Tjc <= 3900 then
        return Tjc
    end
    Sjc.placed, Sjc.plan = nil, nil
    return Utils.json(Sjc):sub(1, 3900)
end

