end
Match.mergeIds = {
}

function Match.mergeScan()
    Match.mergePlan, Match.mergeIds = nil, {
    }
    if not Match.random then
        return
    end
    local D9b = Core.session()
    local E9b = false
    Match.cloneCard = false
    for F9b, G9b in pairs((D9b and D9b.ingame_spells) or {
    }) do
        if G9b == "sacrifice" then
            E9b = true
        elseif G9b == "clone" then
            Match.cloneCard = true
        end
    end
    local H9b = {
    }
    local I9b = Brain.fh.noMerge or {
    }
    for J9b, K9b in ipairs(Match.mine or {
    }) do
        local L9b = K9b._stats
        local M9b = L9b.id.Value
        if not Units.isFarm(M9b) and not Units.allyBuff(M9b) and not Units.idol(M9b) and L9b:FindFirstChild("max_upgrade") and (I9b [M9b] or 0) < 2 then
            local N9b, O9b = pcall(Match.liveDps, K9b, M9b)
            H9b [M9b] = H9b [M9b] or {
            }
            table.insert(H9b [M9b], {
                m = K9b,
                lvl = L9b.upgrade.Value,
                max = L9b.max_upgrade.Value,
                dps = N9b and O9b or 0
            })
        end
    end
    local P9b = {
    }
    for Q9b, R9b in ipairs(Match.team or {
    }) do
        if R9b.hand then
            P9b [R9b.id] = true
        end
    end
    local S9b = {
    }
    for T9b, U9b in pairs(H9b) do
        table.sort(U9b, function(V9b, W9b)
            if V9b.dps ~= W9b.dps then
                return V9b.dps > W9b.dps
            end
            return V9b.lvl > W9b.lvl
        end)
        table.insert(S9b, {
            id = T9b,
            dps = U9b [1].dps * Match.airBoost(U9b [1].m) * Match.reach(U9b [1].m)
        })
    end
    table.sort(S9b, function(X9b, Y9b)
        return X9b.dps > Y9b.dps
    end)
    for Z9b = 1, math.min(3, # S9b) do
        Match.mergeIds [S9b [Z9b].id] = true
    end
    local _9b
    for aac, bac in pairs(H9b) do
        local cac = table.clone(bac)
        table.sort(cac, function(dac, eac)
            if dac.lvl ~= eac.lvl then
                return dac.lvl < eac.lvl
            end
            return dac.dps < eac.dps
        end)
        for fac, gac in ipairs(cac) do
            if gac.m == Match.freshM and fac > 1 then
                table.remove(cac, fac)
                table.insert(cac, 1, gac)
                break
            end
        end
        local hac, iac, jac, kac
        for lac, mac in ipairs(cac) do
            local nac, oac = Utils.flat(mac.m:GetPivot().Position), mac.m._stats.range.Value
            local pac, qac, rac = 0, 0, nil
            for sac, tac in ipairs(bac) do
                if tac ~= mac and (Utils.flat(tac.m:GetPivot().Position) - nac).Magnitude <= oac then
                    pac, qac = pac + tac.dps, qac + 1
                    if not rac or tac.dps > rac.dps then
                        rac = tac
                    end
                end
            end
            if qac > 0 then
                hac, iac, jac, kac = mac, pac, qac, rac
                break
            end
        end
        kac = kac or bac [1]
        local uac = kac.dps * Match.airBoost(kac.m) * Match.reach(kac.m) * (aac == Match.planId and 2 or 1)
        if (Match.mergeIds [aac] or aac == Match.planId) and (hac or P9b [aac]) and (not _9b or uac > _9b.score) then
            _9b = {
                id = aac,
                top = kac,
                fresh = hac,
                near = iac or 0,
                n = jac or 0,
                coming = P9b [aac],
                score = uac
            }
        end
    end
    Match.planId, Match.freshM = _9b and _9b.id, _9b and _9b.fresh and _9b.fresh.m
    Match.mergeHeldAt = (E9b and _9b and _9b.fresh) and (Match.mergeHeldAt or Match.wave()) or nil
    if not _9b then
        return App.status("Merge", "no second copy of a strong unit yet")
    end
    local vac, wac = Match.wave(), (Match.total or 30) - Match.wave()
    local xac = (Match.pressure or 0) >= math.min(Config.dangerReach, ((Match.depth and Match.depth.units > 0 and Match.depth.covEnd) or 1) * 0.9)
    local yac = _9b.fresh
    local zac = not xac and wac > 3
    _9b.waits = yac and yac.lvl <= _9b.top.lvl and _9b.top.lvl < _9b.top.max and zac or false
    local Aac = (not yac or yac.lvl >= _9b.top.lvl) and _9b.coming and zac
    local Bac = Match.cloneCard and _9b.top.lvl >= _9b.top.max and zac
    local Cac = yac and yac.lvl > _9b.top.lvl and _9b.near < 0.3 * yac.dps
    _9b.ready = E9b and yac ~= nil and not Cac and (not (_9b.waits or Aac or Bac) or vac - (Match.mergeHeldAt or vac) >= 5)
    Match.holdNoCardAt = (_9b.waits and not E9b) and (Match.holdNoCardAt or vac) or nil
    _9b.hold = _9b.waits and (E9b or vac - (Match.holdNoCardAt or vac) < 4)
    Match.mergePlan = _9b
    App.status("Merge", yac and string.format("%s: merge %d cop%s into the one with %d upgrades %s", Units.name(_9b.id), _9b.n, _9b.n == 1 and "y" or "ies", yac.lvl, _9b.ready and "now" or (E9b and "once the top copy is maxed" or "when a Merge card comes")) or string.format("%s: a second copy in the hand goes next to it", Units.name(_9b.id)))
end

function Match.mergeHold(Dac)
    local Eac = Match.mergePlan
    return Eac and Eac.hold and Eac.fresh and Eac.fresh.m == Dac or false
end

function Match.mergeBoost(Fac)
    local Gac = Match.mergePlan
    if not (Gac and Gac.top.m == Fac and (Gac.fresh or Gac.coming)) then
        return 1
    end
    return Match.mergeHeldAt and 2 or 1.3
end

function Match.mergeSpot(Hac)
    if not (Match.random and Match.mergeIds [Hac.id]) then
        return nil
    end
    local Iac, Jac
    for Kac, Lac in ipairs(Match.mine or {
    }) do
        if Lac._stats.id.Value == Hac.id then
            local Mac, Nac = pcall(Match.liveDps, Lac, Hac.id)
            Nac = Mac and Nac or 0
            if not Jac or Nac > Jac then
                Iac, Jac = Lac, Nac
            end
        end
    end
    return Iac and Iac:GetPivot().Position
end

function Match.mergeMeasure(Oac)
    local Pac = Match.mergeBefore
    if not Pac then
        return
    end
    task.delay(2, function()
        if not (Oac and Oac.Parent) then
            return
        end
        local Qac, Rac = pcall(Match.liveDps, Oac, Oac._stats.id.Value)
        if not Qac then
            return
        end
        local Sac = Pac.own + 1.5 * Pac.near
        local Tac = Brain.fh.merge or {
            n = 0,
            ratio = 0
        }
        if Sac > 0 then
            Tac.n, Tac.ratio = Tac.n + 1, Tac.ratio + Rac / Sac
        end
        Brain.fh.merge = Tac
        local Uac = Oac._stats.id.Value
        Brain.fh.noMerge = Brain.fh.noMerge or {
        }
        local Vac, Wac = Rac - Pac.own, 1.5 * Pac.near
        if Wac > 0 and Vac < 0.1 * Wac then
            Brain.fh.noMerge [Uac] = (Brain.fh.noMerge [Uac] or 0) + 1
        elseif Wac > 0 and Vac >= 0.5 * Wac then
            Brain.fh.noMerge [Uac] = nil
        end
        App.log(1, "SPELL", string.format("Merge result: %s went from %s to %s damage a second at %d upgrades (its own + 1.5× the copies' %s = %s expected; the top copy had %d)", Units.name(Oac._stats.id.Value), Utils.fmt(Pac.own), Utils.fmt(Rac), Pac.lvl, Utils.fmt(Pac.near), Utils.fmt(Sac), Pac.top))
    end)
end

function Match.farmMergeOk()
    local Xac = Brain.fh.farmMerge
    if not (Xac and Xac.n > 0) then
        return true
    end
    return Xac.ratio / Xac.n >= 0.8
end

function Match.farmMergePair()
    local Yac = {
    }
    for Zac, _ac in ipairs(Match.mine or {
    }) do
        local abc = _ac._stats.id.Value
        if Units.isFarm(abc) and _ac._stats:FindFirstChild("farm_amount") then
            Yac [abc] = Yac [abc] or {
            }
            table.insert(Yac [abc], _ac)
        end
    end
    for bbc, cbc in pairs(Yac) do
        if # cbc >= 2 then
            table.sort(cbc, function(dbc, ebc)
                return dbc._stats.upgrade.Value < ebc._stats.upgrade.Value
            end)
            for fbc, gbc in ipairs(cbc) do
                local hbc, ibc = Utils.flat(gbc:GetPivot().Position), gbc._stats.range.Value
                local jbc, kbc = 0, 0
                for lbc, mbc in ipairs(cbc) do
                    if mbc ~= gbc and (Utils.flat(mbc:GetPivot().Position) - hbc).Magnitude <= ibc then
                        jbc, kbc = jbc + (tonumber(mbc._stats.farm_amount.Value) or 0), kbc + 1
                    end
                end
                if kbc > 0 then
                    return gbc, jbc, kbc
                end
            end
        end
    end
end

function Match.farmMergeSpot(nbc)
