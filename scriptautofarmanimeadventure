-- The farm uses dot calls for live updates. Keep that contract at its boundary,
-- while every Airflow handle itself is always called with colon syntax.
function GUI.valueHandle(native, scale)
    local handle = { Native = native, _isProxy = true }
    function handle.Set(a, b, c)
        if a == handle then
            return native:Set(scale and b / scale or b, c)
        end
        return native:Set(scale and a / scale or a, b)
    end
    function handle.Get()
        local value = native:Get()
        return scale and value * scale or value
    end
    return handle
end

function GUI.paragraph(group, text, title)
    local native
    if title and title ~= "" then
        native = group:CreateParagraph({ Title = GUI.escape(title), Content = GUI.escape(text) })
    else
        native = group:CreateLabel({ Text = GUI.escape(text), Visible = text ~= nil and text ~= "" })
    end
    local handle = { Native = native }
    function handle.Set(a, b)
        local value = a == handle and b or a
        native:Set(GUI.escape(value))
        native:SetVisible(value ~= nil and value ~= "")
    end
    return handle
end

function GUI.shortLine(value, limit)
    local line = tostring(value or ""):match("[^\n]+") or ""
    local at = utf8.offset(line, (limit or 155) + 1)
    if at then line = line:sub(1, at - 1):gsub("%s+%S*$", "") .. "…" end
    return line
end

function GUI.statusCard(group, options, compact)
    local heading = group:CreateLabel({ Text = "" })
    local status = group:CreateStatus({ Name = "State", Value = "", Style = "Badge", Visible = false })
    local body = GUI.paragraph(group, "")
    local progress = group:CreateProgress({ Name = "Wave progress", CurrentValue = 0, Visible = false })
    local handle = {}
    function handle.Set(a, b)
        local data = a == handle and b or a
        data = data or {}
        local title = tostring(data.title or "Status"):gsub("^Up next: ", "")
        heading:Set("<b>" .. GUI.escape((data.icon and (data.icon .. " ") or "") .. title) .. "</b>")
        status:SetVisible(data.tag ~= nil and data.tag ~= "")
        status:Set(GUI.escape(data.tag or ""))
        status:SetTone(data.tagColor or data.color or "Accent")
        local full = table.concat({ tostring(data.text or ""), tostring(data.sub or "") }, "\n")
        heading:SetTooltip(GUI.escape(full))
        local lines = {}
        if data.text and data.text ~= "" then
            local value = compact and GUI.shortLine(data.text) or data.text
            table.insert(lines, tostring(value))
        end
        if data.sub and data.sub ~= "" then
            local value = compact and GUI.shortLine(tostring(data.sub):gsub(" · front at.*$", ""), 110) or data.sub
            table.insert(lines, tostring(value))
        end
        body.Set(table.concat(lines, "\n"))
        body.Native:SetTooltip(GUI.escape(full))
        progress:SetVisible(type(data.progress) == "number")
        if type(data.progress) == "number" then
            progress:Set(math.clamp(data.progress, 0, 1), true)
            progress:SetColor(data.color or "Accent")
        end
    end
    handle.Set(options)
    return handle
end

