    local klc = Reports.hive()
    if not klc then
        return "Nothing shared yet. Once other players' farms send their matches, the farm reads what they learned here every 6 hours."
    end
    local llc, mlc, nlc, olc, plc, qlc = 0, 0, 0, 0, 0, 0
    for rlc in pairs(klc.units) do
        if Reports.hiveUnit(rlc) and not (Brain.learn [rlc] and (Brain.learn [rlc].n or 0) >= 3) then
            llc = llc + 1
        end
    end
    for slc in pairs(type(klc.train) == "table" and klc.train or {
    }) do
        mlc = mlc + 1
    end
    for tlc in pairs(type(klc.stats) == "table" and klc.stats or {
    }) do
        if not Brain.unitData [tlc] then
            nlc = nlc + 1
        end
    end
    for ulc in pairs(type(klc.maps) == "table" and klc.maps or {
    }) do
        if Reports.hiveHp(ulc) and not (Brain.simCal [ulc] and Brain.simCal [ulc].hpCal) then
            olc = olc + 1
        end
    end
    for vlc in pairs(type(klc.drops) == "table" and klc.drops or {
    }) do
        if Reports.hiveDrops(vlc) then
            plc = plc + 1
        end
    end
    for wlc in pairs(type(klc.toggles) == "table" and klc.toggles or {
    }) do
        if not Brain.toggles [wlc] then
            qlc = qlc + 1
        end
    end
    local xlc = {
        string.format("From %d players' %d matches, updated %s.",
        tonumber(klc.players) or 0,
        tonumber(klc.matchRecords) or 0,
        os.date("%b %d %H:%M",
        tonumber(klc.updated) or 0)),
        string.format("What it fills in that your own runs haven't: %d units' readings, %d hidden units' real stats, %d switch abilities, how tough %d maps really are, what %d levels really drop, and takedown rates on %d maps.",
        llc,
        nlc,
        qlc,
        olc,
        plc,
        mlc)
    }
    local ylc = {
    }
    for zlc, Alc in ipairs(type(klc.under) == "table" and klc.under or {
    }) do
        table.insert(ylc, Units.name(Alc) .. (Units.owns(Alc) and " (yours)" or ""))
    end
    if # ylc > 0 then
        table.insert(xlc, "The simulator reads these far too low: " .. table.concat(ylc, ", ") .. ".")
    end
    return table.concat(xlc, "\n")
end

function Reports.suggest(Blc)
    Blc = tostring(Blc or ""):sub(1, 500):gsub("https?://%S+", "[link]"):gsub("@", "(at)")
    if Blc:gsub("%s", "") == "" then
        return false, "empty"
    end
    if Core.WEBHOOK_URL == "" then
        return false, "suggestions aren't connected yet"
    end
    if os.time() - (Brain.lastSuggest or 0) < 600 then
        return false, "one suggestion per 10 minutes"
    end
    local Clc = Reports.postEmbed(string.format("🎌 AA · suggestion · %s · v%s", tostring(Brain.anonId), VERSION), Blc)
    if Clc then
        Brain.lastSuggest = os.time()
    end
    return Clc, Clc and nil or "send failed"
end

-- Airflow UI integration. Game logic keeps its existing handles; every widget is
-- constructed by Robly Airflow using the documented one-table options API.
function GUI.load()
    if GUI.Airflow then
        return GUI.Airflow
    end
    local ok, result = pcall(function()
        local source = game:HttpGet(Core.AIRFLOW_URL)
        local chunk, err = loadstring(source, "=Robly_Airflow")
        assert(chunk, err)
        return chunk()
    end)
    if not ok or type(result) ~= "table" or type(result.CreateWindow) ~= "function" then
        App.log(0, "ERROR", "Robly Airflow could not be loaded: " .. tostring(result))
        return nil
    end
    GUI.Airflow = result
    return result
end

