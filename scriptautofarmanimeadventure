                    Match.emptyAt = Utils.now()
                end
                local fic = Match.total and dic >= Match.total and (eic > 0 or Utils.now() - Match.emptyAt < 30)
                if workspace._DATA.GameStarted.Value and Utils.now() - Chc > (fic and 1800 or 360) then
                    App.log(1, "MATCH", string.format("no progress for %d min — back to the lobby", fic and 30 or 6))
                    App.flush()
                    Chc = Utils.now()
                    App.request("lobby", "teleport_back_to_lobby")
                end
            end)
            if not gic then
                App.log(1, "ERROR", "match loop: " .. tostring(hic))
                task.wait(1)
            end
        end
        if Match.finished then
            break
        end
        task.wait(0.3)
    end
end

