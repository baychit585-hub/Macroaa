    local group = GUI.controlGroup(page, name)
    local visibleName, shortDesc = GUI.controlText(name, desc)
    local rows, labels, byLabel, byValue = {}, {}, {}, {}
    local rawValue, native, storage
    local ready = false
    local handle = {}
    local function rebuild(newOptions)
        rows, labels, byLabel, byValue = {}, {}, {}, {}
        for index, option in ipairs(newOptions or {}) do
            local row = type(option) == "table" and option or { text = tostring(option), value = option }
            local originalText = tostring(row.text or row.value or "")
            local label = originalText
            local modeNames = { On = "Enabled", Off = "Disabled", ["Only this"] = "Only this mode" }
            if modeNames[label] then label = modeNames[label] end
            if label:find("Smart:", 1, true) then label = "Smart" end
            if byLabel[label] then label = label .. " [" .. index .. "]" end
            while byLabel[label] do label = label .. "·" end
            rows[index] = { text = label, originalText = originalText, value = row.value, index = index }
            labels[index], byLabel[label], byValue[row.value] = label, rows[index], label
        end
    end
    local function pending(value)
        if value ~= nil and byValue[value] == nil then
            local label = "Saved selection · loading"
            while byLabel[label] do label = label .. "·" end
            local row = { text = label, value = value, index = #rows + 1 }
            table.insert(rows, row)
            table.insert(labels, label)
            byLabel[label], byValue[value] = row, label
        end
    end
    local function selection(value)
        if multiple then
            local result = {}
            for _, item in ipairs(type(value) == "table" and value or {}) do
                pending(item)
                table.insert(result, byValue[item])
            end
            return result
        end
        pending(value)
        return byValue[value]
    end
    local function persist()
        if storage then storage:Set(Utils.json({ value = rawValue }), true) end
    end
    local function emit()
        if not callback then return end
        if multiple then
            local indexes = {}
            for _, value in ipairs(rawValue or {}) do
                local row = byLabel[byValue[value]]
                if row then table.insert(indexes, row.index) end
            end
            callback(indexes)
        else
            local row = byLabel[byValue[rawValue]]
            if row then callback(row.originalText or row.text, row.value, row.index) end
        end
    end
    rebuild(options)
    if multiple then
        rawValue = {}
        for _, index in ipairs(initial or {}) do
            if rows[index] then table.insert(rawValue, rows[index].value) end
        end
    else
        rawValue = rows[initial or 1] and rows[initial or 1].value or ""
    end
    local selected = selection(rawValue)
    native = group:CreateDropdown({
        Name = visibleName, Desc = shortDesc, Tooltip = desc, Options = labels,
        CurrentOption = selected, MultipleOptions = multiple == true,
        AllowNone = multiple == true, Searchable = true, MaxRows = 8,
        Callback = function(picked)
            if not ready then return end
            if multiple then
                rawValue = {}
                for _, label in ipairs(picked or {}) do
                    if byLabel[label] then table.insert(rawValue, byLabel[label].value) end
                end
            else
                if not byLabel[picked] then return end
                rawValue = byLabel[picked].value
            end
            persist()
            emit()
        end,
    })
    storage = group:CreateInput({
        Name = name .. " saved value", Visible = false,
        Flag = GUI.flag(page, name), CurrentValue = Utils.json({ value = rawValue }),
        Callback = function(text)
            if not ready then return end
            local data = Utils.unjson(text)
            if type(data) ~= "table" or data.value == nil then return end
            if multiple and type(data.value) ~= "table" then return end
            if not multiple and type(data.value) ~= "string" and type(data.value) ~= "number" then return end
            rawValue = data.value
            local value = selection(rawValue)
            native:SetOptions(labels, { KeepSelection = false, Silent = true })
            native:Set(value, true)
            emit()
        end,
    })
    ready = true
    function handle.Refresh(a, b, c)
        local newOptions, value = a, b
        if a == handle then newOptions, value = b, c end
        if value ~= nil then rawValue = value end
        rebuild(newOptions)
        local selectedValue = selection(rawValue)
        native:SetOptions(labels, { KeepSelection = false, Silent = true })
        native:Set(selectedValue, true)
        persist()
    end
    function handle.Set(a, b, c)
        local value, silent = a, b
        if a == handle then value, silent = b, c end
        rawValue = value
        local selectedValue = selection(rawValue)
        native:SetOptions(labels, { KeepSelection = false, Silent = true })
        native:Set(selectedValue, true)
        persist()
        if not silent then emit() end
    end
    function handle.Get() return rawValue end
    handle.Native = native
    return handle
end

function GUI.page(window, name, icon)
    local page = { Name = name, GroupName = "Overview", SectionCount = 0 }
    function page:Group()
        return GUI.block(table.unpack(GUI.sectionSpec(self)))
    end
    function page:Section(title)
        self.SectionCount = self.SectionCount + 1
        self.GroupName = title ~= "" and title or "Details"
        return self:Group()
    end
    function page:Toggle(title, desc, value, callback)
        local ready = false
        local displayName, shortDesc = GUI.controlText(title, desc)
        local native = GUI.controlGroup(self, title):CreateToggle({
            Name = displayName, Desc = shortDesc, Tooltip = desc, CurrentValue = value == true,
            DependsOn = GUI.controlDependency(title), DependsMode = "Disable",
            Flag = GUI.flag(self, title),
            Callback = function(on) if ready and callback then callback(on) end end,
        })
        ready = true
        GUI.nativeToggles = GUI.nativeToggles or {}
        table.insert(GUI.nativeToggles, native)
        return GUI.valueHandle(native)
    end
    function page:Slider(title, desc, options, callback)
        local ready = false
        local scale, suffix = 1, ""
        if options.format then
            local ok, example = pcall(options.format, options.default or options.min or 0)
            if ok and type(example) == "string" then
                if example:match("%%$") then scale, suffix = 0.01, "%"
                elseif example:match("^[%d.%-]+s$") then suffix = "s"
                elseif example:match("^[%d.%-]+ gems$") then suffix = " gems" end
            end
        end
        local displayName, shortDesc = GUI.controlText(title, desc)
        local native = GUI.controlGroup(self, title):CreateSlider({
            Name = displayName, Desc = shortDesc, Tooltip = desc,
            DependsOn = GUI.controlDependency(title), DependsMode = "Disable",
            Range = { (options.min or 0) / scale, (options.max or 100) / scale },
            Increment = (options.step or 1) / scale, CurrentValue = (options.default or options.min or 0) / scale, Suffix = suffix,
            Flag = GUI.flag(self, title),
            Callback = function(value) if ready and callback then callback(value * scale) end end,
        })
        ready = true
        return GUI.valueHandle(native, scale)
    end
    function page:Dropdown(title, desc, options, index, callback)
        return GUI.dropdown(self, title, desc, options, index, callback, false)
    end
    function page:MultiSelect(title, desc, options, indexes, callback)
        return GUI.dropdown(self, title, desc, options, indexes, callback, true)
    end
    function page:Input(title, desc, placeholder, value, callback)
        local ready = false
        local displayName, shortDesc = GUI.controlText(title, desc)
        local native = GUI.controlGroup(self, title):CreateInput({
            Name = displayName, Desc = shortDesc, Tooltip = desc, PlaceholderText = placeholder,
            CurrentValue = value, Flag = GUI.flag(self, title),
            Callback = function(text) if ready and callback then callback(text) end end,
        })
        ready = true
        return GUI.valueHandle(native)
    end
    function page:Button(icon, title, desc, colorOrCallback, finalCallback)
        local callback = finalCallback or colorOrCallback
        local icons = {
            ["Reset Mode Stats"] = "rotate-ccw", ["Pick The Core Units Again"] = "refresh-cw",
            ["Simulate Now"] = "flask-conical", ["Equip Best Team"] = "users",
            ["Restore My Team"] = "undo-2", ["Reset Unit Learning"] = "rotate-ccw",
            
            ["Start Study"] = "microscope", ["Stop Study"] = "square",
            ["Go To Lobby"] = "house", ["Start Farming Again"] = "play",
            ["Save Settings"] = "save", ["Unload"] = "power",
        }
        local displayName, shortDesc = GUI.controlText(title, desc)
        return GUI.controlGroup(self, title):CreateButton({
            Name = displayName, Desc = shortDesc, Tooltip = desc, Icon = icons[title] or "chevron-right",
            Callback = function()
                task.spawn(function()
                    if not App.alive then return end
                    local ok, err = pcall(callback)
                    if not ok then
                        App.log(0, "ERROR", title .. ": " .. tostring(err))
                        window:Notify({ Title = title, Content = GUI.escape(err), Type = "Error" })
                    end
                end)
            end,
        })
    end
    function page:Paragraph(text) return GUI.paragraph(self:Group(), text) end
    function page:Label(text)
        local native = self:Group():CreateLabel({ Text = GUI.escape(text) })
        local handle = {}
        function handle.Set(a, b) native:Set(GUI.escape(a == handle and b or a)) end
        return handle
    end
    function page:StatusCard(options)
        local group, compact = self:Group(), self.Name == "Home"
        if self.Name == "Home" and options.title == "Simulator" then
            group, compact = GUI.block("Battle", "Planner", "Prediction", "Left"), false
        elseif self.Name == "Home" and options.title == "Up next" then
            group = GUI.block("Home", "", "Next run", "Right")
        elseif self.Name == "Fuse" then
            group = GUI.block("Units", "Fusion", "Requirements", "Right")
        end
        return GUI.statusCard(group, options, compact)
    end
    function page:KeyValue(keys)
        local group, cells, values = self:Group(), {}, {}
        local empty = group:CreateLabel({ Text = self.GroupName == "Run records" and "No completed runs yet." or "Waiting for game data." })
        for _, key in ipairs(keys) do
            cells[key] = group:CreateStatus({ Name = GUI.escape(key), Value = "", Style = "Plain", Wrap = true, Visible = false })
        end
        local handle = {}
        function handle.Set(a, b, c, d, e)
            local key, value, color, title = a, b, c, d
            if a == handle then key, value, color, title = b, c, d, e end
            local native = cells[key]
            if not native then return end
            local text = tostring(value or "")
            local visible = text ~= "" and text ~= "—" and text ~= "…"
            values[key] = visible
            native:SetVisible(visible)
            if visible then
                native:SetName(GUI.escape(title ~= nil and title ~= "" and title or key))
                native:Set(GUI.escape(text))
                native:SetColor(color)
            elseif title and title ~= "" and not tonumber(title) then
                empty:Set(GUI.escape(title))
            end
            local any = false
            for _, on in pairs(values) do if on then any = true; break end end
            empty:SetVisible(not any)
        end
        return handle
    end
    function page:StatGrid(keys)
        local group, cells = self:Group(), {}
        local names = { ["First Clears Left"] = "New clears", ["Summer Pearls"] = "Pearls", Record = "Wins / losses" }
        local gold = group:CreateStatus({ Name = "Gold", Value = "…", Style = "Row" })
        for _, key in ipairs(keys) do
            cells[key] = group:CreateStatus({ Name = names[key] or key, Value = "…", Style = "Row" })
        end
        local handle = {}
        function handle.Set(key, value, sub, color)
            local native = cells[key]
            if native then
                native:Set(GUI.escape(value))
                native:SetColor(key == "First Clears Left" and "Text" or color)
                native:SetTooltip(GUI.escape(sub or ""))
                if key == "Gems" and sub then gold:Set(GUI.escape(tostring(sub):gsub("^gold ", ""))) end
            end
        end
        return handle
    end
    return page
end

function GUI.window(Airflow)
    local window = Airflow:CreateWindow({
        Name = GUI.TITLE, LoadingSubtitle = GUI.TITLE .. " · v" .. VERSION,
        ToggleUIKeybind = "RightControl", Size = UDim2.fromOffset(900, 620), AdaptiveSize = true, Density = "Default",
        Backdrop = { Weather = "Fireflies", Tint = 0.35 }, Theme = GUI.THEME,
        ConfigurationSaving = { Enabled = true, FolderName = Core.FOLDER .. "/Airflow" },
        Home = false,
    })
    GUI.NativeWindow = window
    GUI.prepareNavigation(window)
    GUI.skipInfo = GUI.paragraph(GUI.block("Farm", "Rules", "Unavailable modes", "Right"), "Waiting for the first plan.")
    local controller = { Native = window }
    function controller:Tab(_, name)
        local page = GUI.page(window, name)
        if name == "Home" then
            self.State = page:Group():CreateStatus({
                Name = "Farm", Value = "Starting…", Style = "Dot", Pin = true, Tone = "Accent",
            })
            GUI.shortcuts()
        end
        return page
    end
    function controller:Status(text, color)
        if self.State then
            self.State:Set(GUI.escape(text))
            self.State:SetColor(color)
        end
    end
    function controller:Notify(title, text, duration, tone)
        local tones = { success = "Success", warning = "Warning", error = "Error", default = "Info" }
        return window:Notify({ Title = GUI.escape(title), Content = GUI.escape(text), Duration = duration or 4, Type = tones[tone] or "Info" })
    end
    function controller:Destroy()
        -- Airflow turns live toggles off during Destroy. Silence that UI teardown
        -- first, so unloading never overwrites the farm's autosaved preferences.
        for _, toggle in ipairs(GUI.nativeToggles or {}) do toggle:Set(false, true) end
        window:Destroy()
    end
    return controller
end

