function GUI.lbTargetOptions()
    local Zoc = {
        {
            text = "Pick a unit",
            value = ""
        }
    }
    local _oc = Core.session()
    if not _oc then
        return Zoc
    end
    local apc = {
    }
    for bpc, cpc in ipairs(Units.equipped()) do
        apc [cpc.uuid] = true
    end
    local dpc = {
    }
    for epc, fpc in pairs(_oc.profile_data.collection.owned_units) do
        local gpc = _oc.collection:get_unit_by_uuid(epc) or fpc
        local hpc = Core.Units [gpc.unit_id]
        if hpc and (hpc.rarity == "Mythic" or hpc.rarity == "Secret" or apc [epc] or epc == Config.fuseUnit) then
            local ipc, jpc = pcall(Core.USC.get_max_limit_break, gpc)
            local kpc = gpc.further_modifiers and gpc.further_modifiers.limit_break and tonumber(gpc.further_modifiers.limit_break.current_limit_break) or 0
            if (ipc and (tonumber(jpc) or 0) > kpc) or epc == Config.fuseUnit then
                local lpc, mpc = pcall(Units.score, gpc)
                local npc, opc = Strategy.level(gpc), Strategy.cap(gpc)
                table.insert(dpc, {
                    uuid = epc,
                    id = gpc.unit_id,
                    lvl = npc,
                    cap = opc,
                    team = apc [epc],
                    sc = lpc and mpc or 0,
                    key = (epc == Config.fuseUnit and 4 or 0) + (apc [epc] and 2 or 0) + (npc >= opc and 1 or 0)
                })
            end
        end
    end
    table.sort(dpc, function(ppc, qpc)
        if ppc.key ~= qpc.key then
            return ppc.key > qpc.key
        end
        if ppc.sc ~= qpc.sc then
            return ppc.sc > qpc.sc
        end
        return ppc.uuid < qpc.uuid
    end)
    for rpc, spc in ipairs(dpc) do
        if rpc > 60 then
            break
        end
        table.insert(Zoc, {
            text = string.format("%s · Lv %d/%d%s%s",
            Units.name(spc.id),
            spc.lvl,
            spc.cap,
            spc.team and " · team" or "",
            spc.lvl >= spc.cap and " · at cap" or ""),
            value = spc.uuid
        })
    end
    return Zoc
end

function GUI.fodderTable(page)
    local group = GUI.block("Units", "Fusion", "Fodder units", "Left")
    local handle = { data = {} }
    local board, selectionFlag
    local summary = group:CreateStatus({ Name = "Fodder", Value = "Farm picks", Style = "Plain" })
    GUI.paragraph(group, "Click a row to select a unit. ★ marks the farm's safe picks; ⚠ marks something worth keeping. Empty selection uses the farm's safe rule. Locked and equipped units never show.")
    local function selected()
        local result = {}
        for _, uuid in ipairs(Config.fuseFodder or {}) do result[uuid] = true end
        return result
    end
    function handle.points()
        local picked, total = selected(), 0
        for _, unit in ipairs(handle.data) do
            if picked[unit.uuid] then total = total + unit.pts end
        end
        return total
    end
    function handle.summary()
        local requirement = Brain.fuseInfo and Brain.fuseInfo.uuid == Config.fuseUnit and tonumber(Brain.fuseInfo.requirement)
        local count, points = #(Config.fuseFodder or {}), handle.points()
        summary:Set(count == 0 and "Farm picks" or string.format("%d selected · %d%s points", count, points, requirement and (" / " .. requirement) or ""))
        summary:SetColor(requirement and points >= requirement and "Success" or "Accent")
    end
    local function render()
        local picked, rows = selected(), {}
        for _, unit in ipairs(handle.data) do
            local details = { unit.rarity, "Lv " .. tostring(unit.lvl) }
            if unit.evolved then table.insert(details, "evolved") end
            if #(unit.flags or {}) > 0 then table.insert(details, "⚠ " .. table.concat(unit.flags, ", ")) end
            table.insert(rows, {
                picked[unit.uuid] and "✓" or "", GUI.escape(unit.name .. (unit.safe and " ★" or "")),
                GUI.escape(table.concat(details, " · ")), unit.pts,
                UUID = unit.uuid, Highlight = picked[unit.uuid] == true,
            })
        end
        board:SetRows(rows)
        handle.summary()
    end
    local function persist()
        Config.fuseArmSig = ""
        App.saveSoon()
        if selectionFlag then selectionFlag:Set(Utils.json(Config.fuseFodder or {}), true) end
        render()
    end
    board = group:CreateTable({
        Name = "Available fodder", MaxRows = 6, Search = true,
        Columns = {
            { Name = "Pick", Width = 40 }, { Name = "Unit", Width = 0.32 },
            { Name = "Details" }, { Name = "Points", Width = 55, Align = "Right" },
        },
        Rows = {},
        Callback = function(row)
            local picked, result = selected(), {}
            for _, uuid in ipairs(Config.fuseFodder or {}) do
                if uuid ~= row.UUID then table.insert(result, uuid) end
            end
            if not picked[row.UUID] then table.insert(result, row.UUID) end
            Config.fuseFodder = result
            persist()
        end,
    })
    local ready, generation = false, 0
    selectionFlag = group:CreateInput({
        Name = "Fodder selection", Visible = false, Flag = "AA/Fuse/FodderUUIDs",
        CurrentValue = Utils.json(Config.fuseFodder or {}),
        Callback = function(text)
            if not ready then return end
            local values = Utils.unjson(text)
            if type(values) ~= "table" then return end
            local ids = {}
            for _, uuid in ipairs(values) do if type(uuid) == "string" then table.insert(ids, uuid) end end
            generation = generation + 1
            local revision = generation
            -- Profile flags load in arbitrary order. Restore the fodder after the
            -- target-unit callback, which intentionally clears a previous pick.
            task.defer(function()
                if not App.alive or revision ~= generation then return end
                Config.fuseFodder = ids
                persist()
            end)
        end,
    })
    ready = true
    function handle.Refresh(data, emptyText)
        handle.data = data or {}
        summary:SetName(#handle.data == 0 and GUI.escape(emptyText or "No eligible units") or "Fodder")
        selectionFlag:Set(Utils.json(Config.fuseFodder or {}), true)
        render()
    end
    group:CreateButtonRow({
        { Name = "Use farm picks", Callback = function()
            task.spawn(function()
                local session = Core.session()
                local unit = session and session.collection:get_unit_by_uuid(Config.fuseUnit)
                if not unit then return end
                local need = Brain.fuseInfo and Brain.fuseInfo.uuid == unit.uuid and tonumber(Brain.fuseInfo.requirement) or 12
                local fuel, ids = FarmHub.fuseFuel(unit, need), {}
                for _, entry in ipairs(fuel) do table.insert(ids, entry.uuid) end
                Config.fuseFodder = ids
                persist()
            end)
        end },
        { Name = "Clear", Callback = function() Config.fuseFodder = {}; persist() end },
        { Name = "Refresh", Callback = function() GUI.fodderSig = nil end },
    })
    return handle
end

